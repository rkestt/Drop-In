{
  "name": "drop-in-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:https": "next dev --experimental-https",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:design": "node scripts/check-design.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "test:rls": "docker exec -i $(docker ps --format '{{.Names}}' | grep supabase_db) psql -U postgres -d postgres -v ON_ERROR_STOP=1 < tests/rls/assertions.sql",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --project=visual-static tests/e2e/styleguide-visual.spec.ts",
    "test:visual:full": "E2E_WITH_DB=1 playwright test --project=visual-full tests/e2e/screens-visual.spec.ts",
    "db:check": "node scripts/db-check.mjs",
    "stage:alias": "node scripts/stage-alias.mjs",
    "photos:gc": "node scripts/cleanup-orphan-court-photos.mjs",
    "test:a11y": "playwright test tests/e2e/a11y.spec.ts",
    "test:all": "npm run lint && npm run lint:design && tsc --noEmit && vitest run && npm run test:rls && playwright test --project=e2e",
    "types": "npx supabase gen types typescript --local | awk \"/^export /{p=1} p\" > .types.tmp && grep -q \"^export type Database\" .types.tmp && mv .types.tmp lib/supabase/database.types.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^7.0.5",
    "@serwist/next": "^9.5.10",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.105.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "maplibre-gl": "^5.24.0",
    "motion": "^14.11.1",
    "next": "^15.1.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.91.0",
    "serwist": "^9.5.10",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.23",
    "husky": "^9.1.7",
    "jsdom": "^25",
    "lint-staged": "^17.4.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix"
  }
}
