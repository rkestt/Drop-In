# Environment matrix: local / stage (Preview) / prod (Production).
# Full staging runbook: docs/staging.md

# --- NEXT_PUBLIC_SUPABASE_URL ---
# GOTCHA (prod-breaking): on Vercel this MUST be the absolute project URL
# https://<ref>.supabase.co. The relative "/supabase" trick exists ONLY in
# the dev server (next.config.js rewrite is dev-only). A relative value in
# prod silently kills auth, REST and storage (no error, just no backend).
# local: /supabase (dev-server proxy -> SUPABASE_INTERNAL_URL; LAN-safe, no
#   mixed content, no hardcoded LAN IP)
# stage: https://ygnjqqgnxdmgpeeidkbn.supabase.co
# prod:  https://jeuqmmiebzeqtdctmtzj.supabase.co
NEXT_PUBLIC_SUPABASE_URL=/supabase
# --- NEXT_PUBLIC_SUPABASE_ANON_KEY ---
# Placeholder only, never a real key. Public by definition (NEXT_PUBLIC_* is
# inlined into the client bundle), but use the ANON key of the matching
# project per scope, else RLS/auth silently target the wrong backend.
# local: anon key of the local Docker stack
# stage: anon key of drop-in-staging (Vercel Preview scope)
# prod:  anon key of Drop-in (Vercel Production scope)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# --- SUPABASE_INTERNAL_URL (server/dev-only, never NEXT_PUBLIC_) ---
# Where the dev rewrite points. Defaults to http://127.0.0.1:54321.
# local only; unused on Vercel (no rewrite there).
# SUPABASE_INTERNAL_URL=http://127.0.0.1:54321
# --- NEXT_PUBLIC_MAP_PROVIDER ---
# local/stage/prod: openfreemap (default). Set to "osm" for the OSM fallback.
NEXT_PUBLIC_MAP_PROVIDER=openfreemap
# --- NEXT_PUBLIC_LOG_LEVEL (optional, public) ---
# Client log verbosity: debug | info | warn | error. Same value everywhere
# unless debugging a preview deploy.
# NEXT_PUBLIC_LOG_LEVEL=info
# --- LOG_LEVEL (optional, server-only) ---
# Server log verbosity. Never NEXT_PUBLIC_; Vercel scope: Preview + Production.
# LOG_LEVEL=info
# --- NEXT_PUBLIC_ALLOW_MOCK_GPS (optional, public) ---
# Enables mock GPS for testing. Keep UNSET in prod (real location only);
# set to "true" locally or on stage when testing location flows (the code
# checks for the literal "true", not "1").
# NEXT_PUBLIC_ALLOW_MOCK_GPS=
# --- SUPABASE_SERVICE_ROLE_KEY (server-only, NEVER NEXT_PUBLIC_, NOT in Vercel) ---
# The service role key bypasses RLS: it must never ship to the client, so it
# must never get a NEXT_PUBLIC_ prefix. This app has no admin client, so it
# is not needed in Vercel (any scope) or .env.local at all. Local scripts
# that need it take it from the Docker stack, not from this file.
# --- SUPABASE_PROJECT_REF + SUPABASE_ACCESS_TOKEN (server-only, local scripts) ---
# Needed ONLY by scripts/db-check.mjs, the single remote-aware check
# (test:rls and `npm run types` are local-only). Never NEXT_PUBLIC_.
# stage: SUPABASE_PROJECT_REF=ygnjqqgnxdmgpeeidkbn + a staging access token
# prod:  use the prod ref only for read-only checks against prod.
# SUPABASE_PROJECT_REF=
# SUPABASE_ACCESS_TOKEN=
