# Base URL of the local Supabase gateway.
# Leave it relative in development: the Next dev server proxies /supabase/*
# to SUPABASE_INTERNAL_URL, so a phone on the LAN reaches Supabase through the
# dev server over https (no mixed content, no LAN IP to hardcode).
# In production set the absolute project URL instead.
NEXT_PUBLIC_SUPABASE_URL=/supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Where the dev rewrite points. Defaults to http://127.0.0.1:54321.
# SUPABASE_INTERNAL_URL=http://127.0.0.1:54321
NEXT_PUBLIC_MAP_PROVIDER=openfreemap
